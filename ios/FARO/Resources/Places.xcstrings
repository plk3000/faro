      }
    },
    "place.instruction.enough" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You have enough views. More views can improve recognition." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Ya tienes suficientes vistas. Más vistas pueden mejorar el reconocimiento." } }
      }
    },
    "place.instruction.first" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Face the center of the place and capture the first view." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Apunta hacia el centro del lugar y captura la primera vista." } }
      }
    },
    "place.instruction.left" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn slightly left and capture another view." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Gira un poco a la izquierda y captura otra vista." } }
      }
    },
    "place.instruction.lighting" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Capture one final view with different lighting if possible." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Si es posible, captura una última vista con iluminación diferente." } }
      }
    },
    "place.instruction.reverse" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Move to another part of the place and face back." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Muévete a otra parte del lugar y apunta hacia atrás." } }
      }
    },
    "place.instruction.right" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn slightly right and capture another view." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Gira un poco a la derecha y captura otra vista." } }
      }
