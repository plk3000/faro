    "hint.rememberedPlaces" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Lists and manages saved places" } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Muestra y administra los lugares guardados" } }
      }
