      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Captures an image and compares it with remembered places" } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Captura una imagen y la compara con los lugares recordados" } }
