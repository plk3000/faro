      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Starts capturing several views of a named place" } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Comienza a capturar varias vistas de un lugar con nombre" } }
