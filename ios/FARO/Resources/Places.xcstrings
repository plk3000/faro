      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Saves this camera angle for place recognition" } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Guarda este ángulo de cámara para reconocer el lugar" } }
      }
