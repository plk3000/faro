        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FARO usa la cámara para describir escenas cercanas y recordar los lugares que elijas."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FARO uses coarse location to improve recognition of places you save."
