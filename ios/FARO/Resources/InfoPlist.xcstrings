{
  "sourceLanguage" : "en",
  "strings" : {
    "NSBluetoothAlwaysUsageDescription" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "FARO connects to its optional ESP32 obstacle module." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "FARO se conecta a su módulo opcional de obstáculos ESP32." } }
      }
    },
    "NSCameraUsageDescription" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "FARO uses the camera to describe nearby scenes and remember places you choose." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "FARO usa la cámara para describir escenas cercanas y recordar los lugares que elijas." } }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "FARO uses coarse location to improve recognition of places you save." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "FARO usa la ubicación aproximada para mejorar el reconocimiento de los lugares que guardas." } }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "FARO uses the microphone while you hold the voice-command button." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "FARO usa el micrófono mientras mantienes presionado el botón de comando de voz." } }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "FARO transcribes commands such as describe and where am I." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "FARO transcribe comandos como describe y dónde estoy." } }
      }
    }
  },
  "version" : "1.0"
