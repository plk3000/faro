# Azure provider configuration. Keep actual values only in the ignored .env file.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=replace-with-your-azure-key
AZURE_OPENAI_DEPLOYMENT_NAME=your-vision-deployment

# Token issued to the FARO iPhone client. It is not an Azure credential.
FARO_VISION_TOKEN=generate-a-long-random-token

# Service defaults. API_HOST deliberately binds only to loopback by default.
API_HOST=127.0.0.1
API_PORT=8000
FARO_VISION_MAX_IMAGE_SIZE_MB=10
FARO_VISION_RATE_LIMIT_PER_MINUTE=10
REQUEST_TIMEOUT_SECONDS=30
